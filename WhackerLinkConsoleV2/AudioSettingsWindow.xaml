<Window x:Class="WhackerLinkConsoleV2.AudioSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Audio Settings" Height="620" Width="450"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Global Audio Input Device" FontWeight="Bold" Margin="0,0,0,5"/>
        <ComboBox x:Name="InputDeviceComboBox" Width="350" Margin="0,5,0,15" Grid.Row="1"/>

        <!-- PTT Sound Settings -->
        <GroupBox Header="PTT Sounds" Grid.Row="2" Margin="0,0,0,10" Padding="5">
            <StackPanel>
                <CheckBox x:Name="EnablePttDownSoundCheckBox" Content="Enable PTT Down Sound" Margin="0,5,0,5"/>
                <CheckBox x:Name="EnablePttUpSoundCheckBox" Content="Enable PTT Up Sound" Margin="0,0,0,5"/>
                <StackPanel Orientation="Horizontal" Margin="0,5,0,5">
                    <TextBlock Text="PTT Tail Delay (ms):" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox x:Name="PttTailDelayTextBox" Width="80" VerticalAlignment="Center" ToolTip="Time to keep transmission open after releasing PTT (0 to disable)"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- Loudness Boost Settings -->
        <GroupBox Header="Loudness Boost" Grid.Row="3" Margin="0,0,0,10" Padding="5"
                  ToolTip="Extra gain for quiet systems. Peaks are limited so boosting stays free of clipping.">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                    <TextBlock Text="Global default boost:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Slider x:Name="DefaultBoostSlider" Width="150" Minimum="0" Maximum="24" TickFrequency="1"
                            IsSnapToTickEnabled="True" VerticalAlignment="Center"
                            ToolTip="Default boost in dB applied to channels without their own boost (0 = off)"
                            ValueChanged="DefaultBoostSlider_ValueChanged"/>
                    <TextBlock x:Name="DefaultBoostLabel" Text="0 dB" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
                <TextBlock Text="Extra gain for quiet systems; peaks are limited so boosting stays free of clipping. 0 dB = off (unchanged audio). Per-channel boosts can be set below." FontSize="10" Foreground="Gray" TextWrapping="Wrap"/>
            </StackPanel>
        </GroupBox>

        <TextBlock Text="Per-Channel Output Devices" FontWeight="Bold" Grid.Row="4" Margin="0,0,0,5"/>
        <ScrollViewer Grid.Row="4" Height="200" Margin="0,20,0,0">
            <StackPanel x:Name="ChannelOutputStackPanel"/>
        </ScrollViewer>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="5" Margin="0,20,0,0">
            <Button x:Name="SaveButton" Content="Save" Width="100" Margin="0,0,10,0" Click="SaveButton_Click"/>
            <Button x:Name="CancelButton" Content="Cancel" Width="100" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
